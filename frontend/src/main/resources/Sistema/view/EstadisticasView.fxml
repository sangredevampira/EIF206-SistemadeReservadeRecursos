<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.EstadisticasViewController">
   <top>
      <VBox spacing="5.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <Label text="Estadísticas">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Consulte la utilización de recursos y la programación de actividades por período." />
         </children>
      </VBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.5" BorderPane.alignment="CENTER">
         <items>
            <fx:include source="EstadisticasRecursosView.fxml" />
            <fx:include source="EstadisticasActividadesView.fxml" />
         </items>
      </SplitPane>
   </center>
</BorderPane>
