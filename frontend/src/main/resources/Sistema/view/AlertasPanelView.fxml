<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.AlertasPanelController"
      minWidth="265.0"
      prefWidth="285.0"
      maxWidth="320.0"
      spacing="5.0"
      style="-fx-background-color: #E8EBF0;
             -fx-border-color: #B8BEC8;
             -fx-border-width: 0 0 0 1;">

    <padding>
        <Insets top="10.0" right="6.0"
                bottom="8.0" left="6.0"/>
    </padding>

    <children>

        <Label text="Alertas"
               style="-fx-font-size: 13px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #222222;"/>

        <TableView fx:id="tablaAlertas"
                   editable="false"
                   fixedCellSize="27.0"
                   VBox.vgrow="ALWAYS"
                   style="-fx-font-size: 11px;
                          -fx-background-color: #E8EBF0;
                          -fx-border-color: #BEC4CD;">

            <columns>
                <TableColumn fx:id="colActividad"
                             text="Actividad"
                             prefWidth="173.0"/>

                <TableColumn fx:id="colVer"
                             text="Ver"
                             prefWidth="42.0"
                             sortable="false"/>

                <TableColumn fx:id="colDescartar"
                             text="Desc."
                             prefWidth="49.0"
                             sortable="false"/>
            </columns>

            <placeholder>
                <Label text="No hay alertas pendientes."
                       style="-fx-text-fill: #6B7280;
                              -fx-font-size: 11px;"/>
            </placeholder>

        </TableView>

    </children>
</VBox>
