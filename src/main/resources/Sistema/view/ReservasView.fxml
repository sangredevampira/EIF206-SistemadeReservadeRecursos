<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650.0" prefWidth="928.0" spacing="12.0" style="-fx-background-color: #E5E7EB;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.ReservasViewController">
    <padding>
        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
    </padding>
    <children>

        <!-- Sección Nueva Reserva -->
        <VBox spacing="10.0" style="-fx-border-color: #A0AAB5; -fx-border-radius: 4; -fx-background-color: #F3F4F6; -fx-background-radius: 4;">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="8.0" />
            </padding>
            <children>
                <Label text="Nueva reserva">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>

                <!-- Frase y Botón Extraer AI -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="70.0" text="Frase" />
                        <TextField fx:id="txtFrase" prefHeight="40.0" prefWidth="676.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnExtraerAI" mnemonicParsing="false" prefHeight="35.0" prefWidth="99.0" text="Extraer AI">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="17.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/robot.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <!-- Actividad -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="70.0" text="Actividad" />
                        <TextField fx:id="txtActividad" prefHeight="25.0" prefWidth="686.0" HBox.hgrow="ALWAYS" />
                        <Region prefWidth="100.0" />
                    </children>
                </HBox>

                <!-- Fechas y Horas -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="70.0" text="Fecha" />
                        <DatePicker fx:id="dpFecha" prefWidth="200.0">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </DatePicker>
                        <Region prefWidth="30.0" />
                        <Label prefWidth="70.0" text="Hora inicio" />
                        <ComboBox fx:id="cbHoraInicio" prefWidth="150.0" promptText="Seleccione una hora" />
                    </children>
                </HBox>

                <!-- Categorías y Hora fin -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="280.0" text="Categorias requeridas (seleccion multiple)" />
                        <Region prefWidth="30.0" />
                        <Label prefWidth="70.0" text="Hora fin" />
                        <ComboBox fx:id="cbHoraFin" prefWidth="150.0" promptText="Seleccione una hora" />
                    </children>
                </HBox>

                <!-- Contenedor Lista Categorías -->
                <HBox spacing="10.0">
                    <children>
                        <VBox spacing="4.0" style="-fx-border-color: #B0B8C0; -fx-border-radius: 3;" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="4.0" />
                            </padding>
                            <children>
                                <Label text="Categorias">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ListView fx:id="lvCategorias" prefHeight="115.0" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                        <Region prefWidth="100.0" />
                    </children>
                </HBox>

                <!-- Botones Acción -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnReservar" mnemonicParsing="false" prefHeight="30.0" text="Reservar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="13.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/disquete.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnCancelarReserva" mnemonicParsing="false" prefHeight="30.0" text="Cancelar reserva seleccionada">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="19.0" fitWidth="23.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/cancelar.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" text="Limpiar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="17.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/escoba.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region prefWidth="98.0" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Sección Mis Reservas (Más compacta abajo) -->
        <HBox prefHeight="185.0" spacing="10.0">
            <children>
                <VBox spacing="6.0" style="-fx-border-color: #A0AAB5; -fx-border-radius: 4; -fx-background-color: #F3F4F6; -fx-background-radius: 4;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="6.0" />
                    </padding>
                    <children>
                        <Label text="Mis reservas">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TableView fx:id="tvMisReservas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="100.0" text="Id" />
                                <TableColumn fx:id="colActividad" prefWidth="150.0" text="Actividad" />
                                <TableColumn fx:id="colFecha" prefWidth="110.0" text="Fecha" />
                                <TableColumn fx:id="colHorario" prefWidth="110.0" text="Horario" />
                                <TableColumn fx:id="colRecursos" prefWidth="150.0" text="Recursos" />
                                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- Botón Imprimir a la derecha -->
                <VBox alignment="CENTER" prefWidth="120.0">
                    <children>
                        <Button fx:id="btnImprimirReservas" mnemonicParsing="false" prefHeight="35.0" prefWidth="115.0" text="Generar PDF">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/pdf.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </VBox>
            </children>
        </HBox>

    </children>
</VBox>
