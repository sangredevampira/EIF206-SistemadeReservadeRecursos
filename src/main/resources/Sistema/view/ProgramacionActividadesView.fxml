<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox prefHeight="150.0" prefWidth="1100.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0">
               <children>
                  <Label text="Programación semanal de actividades">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Fecha de referencia:" />
                  <DatePicker fx:id="dpFechaReferencia" prefWidth="170.0" promptText="Seleccione una fecha" />
                  <Button fx:id="btnCargar" mnemonicParsing="false" text="Cargar">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/cargar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnLimpiar" mnemonicParsing="false" text="Limpiar">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/escoba.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnGenerarPdf" mnemonicParsing="false" text="Generar PDF">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/pdf.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefWidth="100.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <Label text="Semana:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblRangoSemana" text="Semana no seleccionada" />
                  <Region prefHeight="200.0" prefWidth="672.0" HBox.hgrow="ALWAYS" />
                  <Label text="Estado:" />
                  <Label style="-fx-background-color: #FFF0C7; -fx-text-fill: #8A5A00; -fx-padding: 5 10 5 10; -fx-background-radius: 4;" text="Actividad programada" />
               </children>
            </HBox>
            <TableView fx:id="tvActividades" prefHeight="500.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colHora" resizable="false" sortable="false" text="Hora" />
                <TableColumn fx:id="colLunes" prefWidth="130.0" sortable="false" text="Lunes" />
                  <TableColumn fx:id="colMartes" prefWidth="130.0" sortable="false" text="Martes" />
                  <TableColumn fx:id="colMiercoles" prefWidth="130.0" sortable="false" text="Miércoles" />
                  <TableColumn fx:id="colJueves" prefWidth="130.0" sortable="false" text="Jueves" />
                  <TableColumn fx:id="colViernes" prefWidth="130.0" sortable="false" text="Viernes" />
                  <TableColumn fx:id="colSabado" prefWidth="130.0" sortable="false" text="Sábado" />
                  <TableColumn fx:id="colDomingo" prefWidth="130.0" sortable="false" text="Domingo" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="8.0" />
         </padding>
         <children>
            <Label fx:id="lblEstado" text="Seleccione una fecha para cargar la programación semanal." />
         </children>
      </HBox>
   </bottom>
</BorderPane>
