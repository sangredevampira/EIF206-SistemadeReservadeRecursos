<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox prefWidth="100.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0">
               <children>
                  <Label text="Calendarización de recursos">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label prefHeight="18.0" prefWidth="38.0" text="Fecha:" />
                  <DatePicker fx:id="dpFecha" prefWidth="150.0" promptText="Selección de fecha" />
                  <Label text="Categoría:" />
                  <ComboBox fx:id="cbCategoria" prefWidth="250.0" promptText="Seleccione una categoría" />
                  <Button fx:id="btnCargar" mnemonicParsing="false" text="Cargar">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/cargar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnLimpiar" mnemonicParsing="false" text="Limpiar" />
                  <Region prefHeight="78.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnGenerarPdf" mnemonicParsing="false" text="Generar PDF">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/pdf.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Estado:" />
                  <Label style="-fx-background-color: #DDF3E4; -fx-text-fill: #1E6B3A; -fx-padding: 5 10 5 10; -fx-background-radius: 4;" text="Disponible" />
                  <Label style="-fx-background-color: #FFF0C7; -fx-text-fill: #8A5A00; -fx-padding: 5 10 5 10; -fx-background-radius: 4;" text="Reservado" />
                  <Label style="-fx-background-color: #E5E7EB; -fx-text-fill: #555555; -fx-padding: 5 10 5 10; -fx-background-radius: 4;" text="Fuera del horario" />
               </children>
            </HBox>
            <TableView fx:id="tvCalendarizacion" prefHeight="500.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colHora" prefWidth="90.0" resizable="false" sortable="false" text="Hora" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="8.0" />
         </padding>
         <children>
            <Label fx:id="lblEstado" text="Seleccione una fecha y una categoría para cargar la calendarización" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
