<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="280.0" prefWidth="320.0" spacing="12.0" style="-fx-background-color: #E5E7EB;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Cambiar Clave">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Label fx:id="lblUsuarioObjetivo" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;" />
        <VBox spacing="4.0">
            <children>
                <Label text="Clave Actual" />
                <PasswordField fx:id="campoClaveActual" />
            </children>
        </VBox>
        <VBox spacing="4.0">
            <children>
                <Label text="Clave Nueva" />
                <PasswordField fx:id="campoClaveNueva" />
            </children>
        </VBox>
        <VBox spacing="4.0">
            <children>
                <Label text="Clave Nueva (Confirmación)" />
                <PasswordField fx:id="campoClaveNuevaConfirmacion" />
            </children>
        </VBox>
        <Label fx:id="lblMensaje" textFill="#C0392B" wrapText="true" />
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button fx:id="btnConfirmar" mnemonicParsing="false">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/confirmarVerde.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnCancelar" mnemonicParsing="false">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/cancelarRojo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
