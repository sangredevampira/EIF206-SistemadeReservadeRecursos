<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="641.0" prefWidth="892.0" spacing="10.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.RecursoViewController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
    <children>
        <Region prefHeight="25.0" prefWidth="42.0" />

        <Label prefHeight="20.0" prefWidth="42.0" text="Filtro">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Label>

        <!-- Filtros -->
        <VBox spacing="8.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Categoría" />
                        <ComboBox fx:id="cbFiltroCategoriaRecursos" prefHeight="25.0" prefWidth="176.0" promptText="Seleccione una categoría" />
                        <Region prefHeight="25.0" prefWidth="23.0" />

                        <Label text="Descripción" />
                        <TextField fx:id="txtFiltroDescripcionRecursos" prefHeight="25.0" prefWidth="191.0" />
                        <Region prefHeight="25.0" prefWidth="1.0" />

                        <Button fx:id="btnFiltroBuscarRecursos" mnemonicParsing="false" prefHeight="25.0" prefWidth="81.0" text="Buscar" textAlignment="CENTER">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="13.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/lupa.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region prefHeight="25.0" prefWidth="83.0" />

                        <Button fx:id="btnImprimirRecursos" mnemonicParsing="false" prefHeight="25.0" prefWidth="102.0" text="Generar PDF">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="53.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/pdf.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Formulario Recurso -->
        <VBox prefHeight="173.0" prefWidth="459.0" spacing="8.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <children>
                <Label text="Recurso">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="22.0" />
                        <Label prefHeight="17.0" prefWidth="67.0" text="ID" />
                        <TextField fx:id="txtIdRecurso" prefWidth="220.0" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="22.0" />
                        <Label prefHeight="17.0" prefWidth="66.0" text="Categoría" />
                        <ComboBox fx:id="cbCategoriaRecurso" prefWidth="220.0" promptText="Seleccione una categoría" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="22.0" />
                        <Label prefHeight="17.0" prefWidth="67.0" text="Descripción" />
                        <TextField fx:id="txtDescripcionRecurso" prefWidth="220.0" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <children>
                        <Button fx:id="btnGuardarRecursos" mnemonicParsing="false" text="Guardar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="12.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/disquete.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="btnBorrarRecursos" mnemonicParsing="false" text="Borrar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Button fx:id="btnLimpiarRecursos" mnemonicParsing="false" text="Limpiar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/escoba.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region prefHeight="25.0" prefWidth="115.0" />
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" left="200.0" right="200.0" top="10.0" />
            </VBox.margin>
        </VBox>

        <!-- Tabla -->
        <VBox spacing="6.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
            <children>
                <Label text="Listado">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <TableView fx:id="tvwRecursos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdListadoRecursos" prefWidth="120.0" text="Id" />
                        <TableColumn fx:id="colCategoriaListadoRecursos" prefWidth="180.0" text="Categoria" />
                        <TableColumn fx:id="colDescripcionListadoRecursos" prefWidth="260.0" text="Descripcion" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
