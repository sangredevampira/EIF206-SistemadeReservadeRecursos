<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="570.0" prefWidth="520.0" spacing="10.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="8.0">
         <children>
            <Label text="Recursos">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnGenerarPdfRecursos" mnemonicParsing="false" text="Generar PDF">
               <graphic>
                  <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../images/icons/pdf.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
      <VBox prefWidth="100.0" spacing="8.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Label text="Período de consulta" />
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="7.0">
               <children>
                  <Label text="Desde:" />
                  <DatePicker fx:id="dpDesdeRecursos" prefWidth="130.0" promptText="Fecha inicial" />
                  <Label text="Hasta:" />
                  <DatePicker fx:id="dpHastaRecursos" prefWidth="130.0" promptText="Fecha final" />
                  <Button fx:id="btnCargarRecursos" mnemonicParsing="false" text="Cargar">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/icons/cargar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefWidth="100.0" spacing="6.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Label text="Estadísticas" />
            <TableView fx:id="tvEstadisticasRecursos" minHeight="120.0" prefHeight="145.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="colCategoria" prefWidth="120.0" sortable="false" text="Categoria" />
                <TableColumn fx:id="colCantidadRecursos" prefWidth="120.0" sortable="false" text="Cantidad" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Label text="Gráfico" />
            <BarChart fx:id="barChartRecursos" animated="false" categoryGap="20.0" legendVisible="false" prefHeight="250.0" title="Recursos Usados" VBox.vgrow="ALWAYS">
              <xAxis>
                <CategoryAxis fx:id="ejeRecurso" label="Recurso" side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis fx:id="ejeCantidadRecursos" label="Cantidad" side="LEFT" />
              </yAxis>
            </BarChart>
            <Label fx:id="lblEstadoRecursos" text="Seleccione las fechas para consultar las actividades programadas." textFill="#555555" wrapText="true" />
         </children>
      </VBox>
   </children>
</VBox>
