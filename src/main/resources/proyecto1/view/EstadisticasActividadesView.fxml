<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="570.0" prefWidth="520.0" spacing="10.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="8.0">
         <children>
            <Label text="Actividades">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnGenerarPdfActividades" mnemonicParsing="false" text="Generar PDF">
               <graphic>
                  <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../images/icons/pdf.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
      <VBox prefWidth="100.0" spacing="8.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Label text="Período de consulta" />
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="7.0">
               <children>
                  <Label text="Desde:" />
                  <DatePicker fx:id="dpDesdeActividades" prefWidth="130.0" promptText="Fecha inicial" />
                  <Label text="Hasta:" />
                  <DatePicker fx:id="dpHastaActividades" prefWidth="130.0" promptText="Fecha final" />
                  <Button fx:id="btnCargarActividades" mnemonicParsing="false" text="Cargar" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefWidth="100.0" spacing="6.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Label text="Estadísticas" />
            <TableView fx:id="tvEstadisticasActividades" minHeight="120.0" prefHeight="145.0" prefWidth="200.0">
              <columns>
                <TableColumn fx:id="colSemana" prefWidth="120.0" sortable="false" text="Semana" />
                <TableColumn fx:id="colCantidad" prefWidth="120.0" sortable="false" text="Cantidad" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <Label text="Gráfico" />
            <BarChart fx:id="barChartActividades" animated="false" categoryGap="20.0" legendVisible="false" prefHeight="250.0" title="Actividades Realizadas" VBox.vgrow="ALWAYS">
              <xAxis>
                <CategoryAxis fx:id="ejeSemanas" label="Semana" side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis fx:id="ejeCantidad" label="Cantidad" side="LEFT" />
              </yAxis>
            </BarChart>
            <Label fx:id="lblEstadoActividades" text="Seleccione las fechas para consultar las actividades programadas." textFill="#555555" wrapText="true" />
         </children>
      </VBox>
   </children>
</VBox>
