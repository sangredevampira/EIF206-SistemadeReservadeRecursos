<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="641.0" prefWidth="892.0" spacing="10.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>
    <children>
        <Region prefHeight="25.0" prefWidth="42.0" />

        <Label prefHeight="20.0" prefWidth="42.0" text="Filtro">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Label>


        <VBox spacing="8.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Categoría" />
                        <ComboBox fx:id="cbFiltroCategoria" prefHeight="25.0" prefWidth="176.0" />
                        <Region prefHeight="25.0" prefWidth="23.0" />

                        <Label text="Descripción" />
                        <TextField fx:id="txtFiltroDescripcion" prefHeight="25.0" prefWidth="191.0" />
                        <Region prefHeight="25.0" prefWidth="1.0" />

                        <Button fx:id="btnBuscar" mnemonicParsing="false" prefHeight="25.0" prefWidth="81.0" text="Buscar" textAlignment="CENTER">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="13.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../../../../../../../Downloads/lupa.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region prefHeight="25.0" prefWidth="83.0" />

                        <Button fx:id="btnImprimir" mnemonicParsing="false" prefHeight="25.0" prefWidth="102.0" text="Generar PDF">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="53.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../../../../../../../Downloads/pdf.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>


        <VBox prefHeight="173.0" prefWidth="459.0" spacing="8.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <children>
                <Label text="Recurso">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>

                <!-- ID -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="22.0" />
                        <Label prefHeight="17.0" prefWidth="67.0" text="ID" />
                        <TextField fx:id="txtIdRecurso" prefWidth="220.0" />
                    </children>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </HBox>

                <!-- Categoría -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="22.0" />
                        <Label prefHeight="17.0" prefWidth="66.0" text="Categoría" />
                        <ComboBox fx:id="cbCategoriaRecurso" prefWidth="220.0" />
                    </children>
                </HBox>

                <!-- Descripción -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="22.0" />
                        <Label prefHeight="17.0" prefWidth="67.0" text="Descripción" />
                        <TextField fx:id="txtDescripcionRecurso" prefWidth="220.0" />
                    </children>
                </HBox>

                <!-- Botones -->
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <children>
                        <Region prefHeight="25.0" prefWidth="0.0" />
                        <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="12.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../../../../../../../Downloads/disquete.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <Button fx:id="btnBorrar" mnemonicParsing="false" text="Borrar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>

                        <Button fx:id="btnLimpiar" mnemonicParsing="false" text="Limpiar">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../../../../../../../Downloads/escoba.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region prefHeight="25.0" prefWidth="115.0" />
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" left="200.0" right="200.0" top="10.0" />
            </VBox.margin>
        </VBox>


        <VBox spacing="6.0" style="-fx-border-color: #C8CDD3; -fx-border-radius: 4; -fx-background-color: #FAFBFC; -fx-background-radius: 4;" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
            <children>
                <Label text="Listado">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <TableView fx:id="tvRecursos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="120.0" text="Id" />
                        <TableColumn fx:id="colCategoria" prefWidth="180.0" text="Categoría" />
                        <TableColumn fx:id="colDescripcion" prefWidth="260.0" text="Descripción" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>